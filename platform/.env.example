ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_DB=utn
POSTGRES_USER=utn
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql+psycopg://utn:password@postgres:5432/utn
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
SCOPUS_MODE=mock
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
ELSEVIER_BASE_URL=https://api.elsevier.com/content
SCOPUS_REQUEST_TIMEOUT=30
SCOPUS_MAX_RETRIES=3
MAX_CSV_BYTES=10000000
EXPORT_DIR=/app/exports
SCHEDULED_SYNC_SECRET=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
UTN_ALIASES=University of Technology Nuremberg|Technische Universität Nürnberg|UTN
UTN_AFFILIATION_IDS=
SEED_ADMIN_PASSWORD=choose-a-development-password
SEED_VIEWER_PASSWORD=choose-a-different-development-password
